{
  "name": "VSD SCL C1D 1.2um ORFS",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "overrideCommand": false,
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "SCL C1D noVNC Desktop",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "containerEnv": {
    "DISPLAY": ":1",
    "TMPDIR": "/tmp/orfs",
    "OPENROAD_EXE": "/usr/local/bin/openroad",
    "YOSYS_EXE": "/opt/oss-cad-suite/bin/yosys",
    "KLAYOUT_CMD": "/usr/bin/klayout"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash scripts/post-create.sh"
}
